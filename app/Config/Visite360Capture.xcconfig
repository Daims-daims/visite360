// Réglages de construction de l'app, communs à tous.
//
// Les réglages propres à un Mac (l'équipe de signature) vont dans Local.xcconfig, à côté de ce
// fichier. Il est ignoré par git : le copier depuis Local.xcconfig.exemple. S'il manque, l'app
// se construit quand même, et Xcode demande de choisir une équipe pour l'installer sur un iPhone.

#include? "Local.xcconfig"
