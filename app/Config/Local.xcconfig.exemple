// Réglages propres à ce Mac, jamais dans le dépôt.
//
// Copier ce fichier en Local.xcconfig dans le même dossier, puis remplacer la valeur par
// l'identifiant de son équipe de signature (dix caractères, visible dans Xcode : Settings,
// Accounts, l'équipe « (Personal Team) » de son identifiant Apple).

DEVELOPMENT_TEAM = ABCDE12345

// Adresse du serveur du projet (étape 13, docs/serveur.md). Dans ce fichier, « // » commence un
// commentaire : écrire « https:/$()/ » à la place de « https:// ». Pour le serveur lancé sur le
// Mac (visite360 serveur --local), donner l'adresse qu'il affiche, par exemple
// http:/$()/192.168.1.20:8080.
VISITE360_SERVEUR = https:/$()/api.mon-domaine.fr
